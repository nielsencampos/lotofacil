# PostgreSQL connection used by both the Python app and dbt.
# Postgres runs in Docker (docker-compose.yml); Python/dbt run locally via uv
# and reach it through the port published on localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lotofacil
POSTGRES_USER=lotofacil
POSTGRES_PASSWORD=lotofacil

# Lotofacil public API (Caixa Economica Federal)
LOTOFACIL_API_BASE_URL=https://servicebus2.caixa.gov.br/portaldeloterias/api/lotofacil

# Where raw JSON draw files are stored/read from
LOTOFACIL_DATA_DIR=data/raw

# dbt
DBT_PROFILES_DIR=dbt
